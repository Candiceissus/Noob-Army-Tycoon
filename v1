end

-- Resolves a prompt's real WORLD position. Using prompt.Parent.Position
-- directly breaks when the prompt is parented to something other than a
-- plain BasePart — e.g. an Attachment, whose .Position is a LOCAL offset,
-- not a world position. Using that local offset as a world CFrame is
-- exactly what sends you flying to the middle of the map. This checks the
-- parent type and always returns a proper world-space Vector3.
local function getPromptWorldPosition(prompt)
    local parent = prompt.Parent
    if not parent then return nil end
    if parent:IsA("Attachment") then
        return parent.WorldPosition
    elseif parent:IsA("BasePart") then
        return parent.Position
    elseif parent:IsA("Model") then
        local ok, pivot = pcall(function() return parent:GetPivot() end)
        if ok and pivot then return pivot.Position end
        if parent.PrimaryPart then return parent.PrimaryPart.Position end
    end
    return nil
end

local function tweenTo(pos)
    if not pos then return end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if root then
        tweenService:Create(root, tweenInfo, {CFrame = CFrame.new(pos + Vector3.new(0, 5, 0))}):Play()
        wait(1.6)
    end
end

local function isAvailable(prompt)
    return prompt and prompt.Enabled and prompt.Parent and prompt.Parent.Parent
end

-- Strict matcher: compares case-insensitively and anchors the pattern
-- so "Noob Worker" doesn't accidentally match something like
-- "Noob Worker Booster" or "Noob Worker Hut". Numbers are matched with %d+.
local function matchesExact(text, pattern)
    if not text then return false end
    local lowerText = text:lower()
    local lowerPattern = pattern:lower()
    return lowerText:match(lowerPattern) ~= nil
end

-- Patterns anchored with ^...$ so names must be an exact shape, nothing extra.
-- ObjectText is the small line for ALL prompt types: "Noob Worker 70",
-- "Noob Researcher 35", "Upgrade screen", "Upgrade PC" — no price in it.
local NOOB_WORKER_PATTERN = "^noob worker %d+$"
local NOOB_RESEARCHER_PATTERN = "^noob researcher %d+$"
local UPGRADE_SCREEN_PATTERN = "^upgrade screen$"
local UPGRADE_PC_PATTERN = "^upgrade pc$"

-- The price lives in ActionText, e.g. "Upgrade for $66000" or
-- "Upgrade for $198.00k" (the "k" suffix means thousands).
local function parsePrice(text)
    if not text then return nil end
    local numPart, suffix = text:match("%$([%d,%.]+)(%a*)")
    if not numPart then return nil end
    numPart = numPart:gsub(",", "")
    local value = tonumber(numPart)
    if not value then return nil end
    suffix = suffix:lower()
    if suffix == "k" then
        value = value * 1000
    elseif suffix == "m" then
        value = value * 1000000
    end
    return value
end

-- Scans the whole tycoon for available upgrade prompts whose ObjectText
-- matches `pattern` exactly, and returns the one with the lowest price
-- (parsed from ActionText).
local function findCheapestUpgrade(tycoon, pattern)
    local best, bestPrice = nil, nil
    for _, prompt in pairs(tycoon:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and isAvailable(prompt)
            and matchesExact(prompt.ObjectText, pattern) then
            local price = parsePrice(prompt.ActionText)
            if price and (bestPrice == nil or price < bestPrice) then
                best, bestPrice = prompt, price
            end
        end
    end
    return best
end

-- Auto Buy Money Worker
local buyWorkerRunning = false
Farm:Toggle("Auto Buy Money Worker", false, function(t)
    buyWorkerRunning = t
    if t then
        local conn = spawn(function()
            while buyWorkerRunning do
                local tycoon = getTycoon()
                if tycoon then
                    for _, prompt in pairs(tycoon:GetDescendants()) do
                        if not buyWorkerRunning then break end
                        if prompt:IsA("ProximityPrompt") and isAvailable(prompt)
                            and matchesExact(prompt.ObjectText, NOOB_WORKER_PATTERN) then
                            tweenTo(getPromptWorldPosition(prompt))
                            fireproximityprompt(prompt)
                            wait(0.8)
                            break
                        end
                    end
                end
                wait(0.5)
            end
        end)
        table.insert(connections, conn)
    end
end)

