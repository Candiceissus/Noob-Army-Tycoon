-- Auto Vote Tab
local Main = win:Tab("Auto Vote")

local voteRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes", true):FindFirstChild("Other", true):FindFirstChild("VoteGamemode")

-- Each vote toggle now keeps its own connection reference and disconnects
-- it the moment the toggle goes off, instead of letting the Heartbeat
-- connection run forever regardless of toggle state.
local function createVoteToggle(name)
    local voteConn = nil
    Main:Toggle("Auto " .. name, false, function(t)
        if t then
            voteConn = game:GetService("RunService").Heartbeat:Connect(function()
                if voteRemote then voteRemote:FireServer(name) end
            end)
            table.insert(connections, voteConn)
        else
            if voteConn then
                voteConn:Disconnect()
                voteConn = nil
            end
        end
    end)
end

createVoteToggle("King of the hill")
createVoteToggle("Classic")
createVoteToggle("Blitz")
createVoteToggle("PvE")
createVoteToggle("Red noobs invasion")
createVoteToggle("Daily challenge")

