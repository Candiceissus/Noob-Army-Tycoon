-- WalkSpeed: toggle enables enforcing the slider value every frame;
-- turning it off resets WalkSpeed back to the Roblox default (16).
local ROBLOX_DEFAULT_WALKSPEED = 16
local walkSpeedEnabled = false
local walkSpeedValue = ROBLOX_DEFAULT_WALKSPEED

Misc:Toggle("WalkSpeed Enabled", false, function(t)
    walkSpeedEnabled = t
    if not t and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = ROBLOX_DEFAULT_WALKSPEED
    end
end)

Misc:Slider("WalkSpeed", ROBLOX_DEFAULT_WALKSPEED, 250, ROBLOX_DEFAULT_WALKSPEED, function(v)
    walkSpeedValue = v
end)

-- JumpPower: same pattern, default/minimum is Roblox's default (50).
